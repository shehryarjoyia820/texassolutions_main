# ---------------------------------------------------------------
# Texas Solutions — environment variables
# Copy to .env.local for development, or set in the Vercel dashboard.
# Everything here is optional: the site builds and runs without it,
# and form submissions are simply logged until integrations are added.
# ---------------------------------------------------------------

# Where forms POST. Leave unset on Vercel to use the built-in route handler.
# For the DreamHost static export, set it to the PHP endpoint:
# NEXT_PUBLIC_FORM_ENDPOINT=/api/submit.php
NEXT_PUBLIC_FORM_ENDPOINT=

# --- Email (Resend) ---------------------------------------------
RESEND_API_KEY=
FROM_EMAIL="Texas Solutions <noreply@texassolutions.co>"
NOTIFY_EMAIL=info@texassolutions.co

# --- CRM ---------------------------------------------------------
# HubSpot, Zoho or GoHighLevel inbound webhook URL.
CRM_WEBHOOK_URL=

# --- Spam protection (Cloudflare Turnstile) ----------------------
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Analytics ---------------------------------------------------
# Nothing fires until the visitor accepts analytics cookies.
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_CLARITY_ID=

# --- Website chatbot (runs on the Vercel deployment) --------------
# The chat button only appears once GEMINI_API_KEY and a database are set.
GEMINI_API_KEY=
# Optional; defaults to gemini-3.8-flash.
GEMINI_MODEL=
# Postgres connection string. Adding Neon from the Vercel Marketplace sets it.
DATABASE_URL=
# Password for /admin (leads, transcripts, knowledge, review flags).
ADMIN_PASSWORD=
# Optional: separate secret for signing admin sessions.
ADMIN_SESSION_SECRET=
# Optional: where the static site's widget calls the chat API.
# NEXT_PUBLIC_CHAT_API=https://texassolutions-main.vercel.app
