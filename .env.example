# ---------------------------------------------------------------
# Texas Solutions — environment variables
# Copy to .env.local for development, or set in the Vercel dashboard.
# Everything here is optional: the site builds and runs without it,
# and form submissions are simply logged until integrations are added.
# ---------------------------------------------------------------

# Where forms POST. Leave unset on Vercel to use the built-in route handler.
# For the DreamHost static export, set it to the PHP endpoint:
# NEXT_PUBLIC_FORM_ENDPOINT=/api/submit.php
NEXT_PUBLIC_FORM_ENDPOINT=

# --- Email (Resend) ---------------------------------------------
RESEND_API_KEY=
FROM_EMAIL="Texas Solutions <noreply@texassolutions.co>"
NOTIFY_EMAIL=sales@texassolutions.co

# --- CRM ---------------------------------------------------------
# HubSpot, Zoho or GoHighLevel inbound webhook URL.
CRM_WEBHOOK_URL=

# --- Spam protection (Cloudflare Turnstile) ----------------------
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Analytics ---------------------------------------------------
# Nothing fires until the visitor accepts analytics cookies.
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_CLARITY_ID=
